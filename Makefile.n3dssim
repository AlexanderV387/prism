# Headless Linux build of prism with the 3DS texture code (3ds/texture_3ds.cpp)
# on a simulated GPU and linear memory (linux/n3dssim): for finding the 3DS
# texture code's faults on a PC, with AddressSanitizer.
#
# Usage: make -f Makefile.n3dssim -j$(nproc)

include Makefile.common

OBJS += windows/file_win.o windows/math_win.o windows/log_win.o \
windows/romdisk_win.o windows/saveload_win.o windows/memoryhandler_win.o windows/logoscreen_win.o \
windows/framerateselect_win.o \
web/netplay_web.o linux/windowfocusscreen_linux.o

OBJS += linux/system_linux.o linux/n3dssim/n3dssim.o 3ds/texture_3ds.o \
linux/input_linux.o linux/screeneffect_linux.o \
linux/sound_linux.o linux/soundeffect_linux.o linux/thread_linux.o

OBJDIR = build_n3dssim
BINDIR = bin_n3dssim
SIM_OBJS = $(addprefix $(OBJDIR)/,$(OBJS))

CXX ?= g++
CXXFLAGS = -std=c++17 -fpermissive -O1 -g -fsanitize=address -fno-omit-frame-pointer -Wno-write-strings \
	-DN3DS_TEXTURE_SIM -Iinclude -Ilinux/n3dssim -Ilinux/shim $(shell pkg-config --cflags libpng zlib) \
	-include cstdint -include cstring

all: $(BINDIR)/libprism.a

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BINDIR)/libprism.a: $(SIM_OBJS)
	@mkdir -p $(BINDIR)
	ar rcs $@ $(SIM_OBJS)

clean:
	rm -rf $(OBJDIR) $(BINDIR)
